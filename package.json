{
  "name": "rosetta",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:go": "go test ./packages/contracts/... ./packages/parser/...",
    "check:boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:go && pnpm check:boundaries"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
