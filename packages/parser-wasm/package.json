{
  "name": "@rosetta/parser-wasm",
  "version": "0.1.0",
  "description": "WebAssembly build of the Rosetta parser plus the Web Worker client.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./wasm": "./dist/rosetta.wasm",
    "./wasm_exec": "./dist/wasm_exec.js"
  },
  "scripts": {
    "build:wasm": "node scripts/build.mjs",
    "build:js": "node scripts/bundle.mjs",
    "build": "node scripts/build.mjs && node scripts/bundle.mjs && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/build.mjs && node scripts/bundle.mjs",
    "test": "vitest run --passWithNoTests=false",
    "demo": "node scripts/serve-demo.mjs"
  },
  "dependencies": {
    "@rosetta/contracts": "workspace:^"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
