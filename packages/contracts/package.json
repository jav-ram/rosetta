{
  "name": "@rosetta/contracts",
  "version": "0.0.0",
  "description": "Language-neutral contracts: JSON Schemas, generated TS types and Go structs, conformance suites.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests=false"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "11.9.3",
    "json-schema-to-typescript": "^16.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
