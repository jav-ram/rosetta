{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RosettaContracts",
  "description": "Index of every top-level contract. Used as the single entry point for code generation.",
  "$defs": {
    "Document": { "$ref": "ast.schema.json" },
    "ComponentDefinition": { "$ref": "component-definition.schema.json" },
    "Warning": { "$ref": "warning.schema.json" },
    "Position": { "$ref": "position.schema.json" },
    "Theme": { "$ref": "theme.schema.json" },
    "Manifest": { "$ref": "manifest.schema.json" },
    "Chapter": { "$ref": "chapter.schema.json" },
    "AssetRef": { "$ref": "asset-ref.schema.json" },
    "ProjectSummary": { "$ref": "project-summary.schema.json" }
  }
}
