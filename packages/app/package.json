{
  "name": "@rosetta/app",
  "version": "0.15.0",
  "description": "The Rosetta web app. The only package that composes the others.",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "predev": "pnpm --filter @rosetta/parser-wasm run build:wasm",
    "dev": "vite",
    "prebuild": "pnpm --filter @rosetta/parser-wasm run build:wasm",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "cf:preview": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @rosetta/parser-wasm run build:wasm",
    "test": "vitest run --passWithNoTests=false"
  },
  "dependencies": {
    "@rosetta/contracts": "workspace:^",
    "@rosetta/editor": "workspace:^",
    "@rosetta/parser-wasm": "workspace:^",
    "@rosetta/preview": "workspace:^",
    "@rosetta/store-local": "workspace:^",
    "@rosetta/theme-classic": "workspace:^",
    "@rosetta/theme-engine": "workspace:^",
    "pagedjs": "0.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.2",
    "vite": "^7.3.7",
    "wrangler": "^4.151.1"
  }
}
