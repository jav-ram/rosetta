{
  "name": "@rosetta/editor",
  "version": "0.1.0",
  "description": "Framework-agnostic Tiptap editor, node view framework and Markdown serializer.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests=false"
  },
  "dependencies": {
    "@rosetta/contracts": "workspace:^",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
