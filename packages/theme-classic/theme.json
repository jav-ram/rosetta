{
  "name": "Classic",
  "tokens": {
    "font.body": "Georgia, \"Times New Roman\", serif",
    "font.heading": "\"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif",
    "font.furniture": "\"Gill Sans\", Calibri, \"Trebuchet MS\", sans-serif",
    "font.mono": "\"Courier New\", monospace",
    "font.size-body": "10pt",
    "font.size-small": "8pt",
    "font.size-h1": "24pt",
    "font.size-h2": "16pt",
    "font.size-h3": "13pt",
    "font.size-h4": "11pt",
    "font.size-title": "13pt",
    "font.line-height": "1.35",

    "color.text": "#2b2420",
    "color.heading": "#58180d",
    "color.accent": "#8a1c1c",
    "color.muted": "#6b5d52",
    "color.rule": "#b58b5a",
    "color.page": "#ffffff",
    "color.statblock-bg": "#fdf1dc",
    "color.statblock-edge": "#7a200d",
    "color.readaloud-bg": "#efe4cb",
    "color.readaloud-edge": "#8a6a3b",
    "color.sidebar-bg": "#e9ede4",
    "color.sidebar-edge": "#5d6b4f",
    "color.table-stripe": "#f4ead4",
    "color.warning-bg": "#fff3cd",
    "color.warning-text": "#7a4b00",

    "border.rule": "0.5pt solid var(--color-rule)",
    "border.heading-rule": "1pt solid var(--color-accent)",
    "border.statblock": "2pt solid var(--color-statblock-edge)",
    "border.statblock-inner": "0.5pt solid var(--color-statblock-edge)",
    "border.readaloud": "3pt solid var(--color-readaloud-edge)",
    "border.sidebar": "1pt solid var(--color-sidebar-edge)",
    "border.table-row": "0.5pt solid var(--color-rule)",
    "border.warning": "1pt solid var(--color-warning-text)",
    "border.column-rule": "none",
    "border.radius-frame": "2pt",

    "spacing.block": "6pt",
    "spacing.heading-above": "12pt",
    "spacing.heading-below": "4pt",
    "spacing.frame": "8pt",
    "spacing.list-indent": "14pt",
    "spacing.field": "2pt",
    "spacing.cell": "2pt 4pt",

    "page.size": "A4",
    "page.margin-top": "22mm",
    "page.margin-bottom": "22mm",
    "page.margin-left": "18mm",
    "page.margin-right": "18mm",
    "page.columns": "2",
    "page.column-gap": "8mm",

    "texture.page": "none",
    "mask.art": "none"
  }
}
