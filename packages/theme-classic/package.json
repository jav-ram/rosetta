{
  "name": "@rosetta/theme-classic",
  "version": "0.4.0",
  "description": "The built-in v1 theme (tokens, CSS, assets).",
  "type": "module",
  "files": [
    "rosetta-package.json",
    "theme.json",
    "content.css",
    "pages.css",
    "lint.mjs"
  ],
  "exports": {
    "./theme.json": "./theme.json",
    "./content.css": "./content.css",
    "./pages.css": "./pages.css",
    "./lint.mjs": "./lint.mjs",
    "./rosetta-package.json": "./rosetta-package.json"
  },
  "scripts": {
    "build": "node --check lint.mjs && node --check test/theme.test.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
